// schema.prisma
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  books     Book[]
}

model Book {
  id            Int      @id @default(autoincrement())
  title         String
  author        String
  description   String?
  isRead        Boolean  @default(false)
  isFavorite    Boolean  @default(false)
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
}
